{
  "name": "chatbot-fisio-personal",
  "version": "0.1.0",
  "private": true,
  "description": "Chatbot de WhatsApp (Meta Cloud API) para clínica de fisioterapia e personal trainer: triagem, FAQ, agendamento e lembretes.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "1.20.0",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "prisma": "7.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true
  }
}
