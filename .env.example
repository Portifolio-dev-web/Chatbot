# Modelo de configuração. Copie para `.env` (que NUNCA vai para o git) e preencha.
# Para gerar valores aleatórios fortes (funciona em qualquer sistema com Node):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
# Só "development" (ou "test", usado pelos testes) desliga as travas de produção.
# Ausente ou digitado errado = produção: o servidor exige TLS no banco, política de
# privacidade em https etc., e se recusa a subir se faltar algo.
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# ---------------------------------------------------------------------------
# Senha do PostgreSQL do docker compose. Só letras e números (ela vai dentro da URL de
# conexão; símbolos quebrariam a URL). Gere com:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# Fora do Docker (npm run dev): a URL do seu PostgreSQL. No docker compose ela é montada
# automaticamente (serviço "db") e este valor é ignorado.
# Em produção com banco gerenciado (Render, Railway, Neon...), inclua ?sslmode=require.
DATABASE_URL=postgresql://chatbot:troque-esta-senha@localhost:5432/chatbot
# Só "true" quando o banco roda na MESMA máquina/rede privada (ex.: docker compose),
# onde não há TLS. É uma dispensa explícita, para não acontecer por esquecimento.
DATABASE_TLS_DISABLED=false

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (painel da Meta: developers.facebook.com > seu app > WhatsApp)
# ---------------------------------------------------------------------------
# Senha que VOCÊ inventa e cola no painel da Meta ao cadastrar o webhook.
# Mínimo de 32 caracteres; gere com o comando do topo.
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > "Chave secreta do aplicativo".
# Usada para conferir a assinatura (X-Hub-Signature-256) de cada mensagem recebida:
# sem ela, qualquer um na internet poderia fingir ser a Meta.
WHATSAPP_APP_SECRET=
# Token de acesso. Em produção use o de um "usuário do sistema" (não expira),
# não o token temporário de 24 h da tela de testes.
WHATSAPP_ACCESS_TOKEN=
# "Identificação do número de telefone" (Phone Number ID), não o número em si.
WHATSAPP_PHONE_NUMBER_ID=
# Versão da Graph API. Confira a mais recente no painel da Meta.
WHATSAPP_API_VERSION=v25.0

# ---------------------------------------------------------------------------
# Criptografia dos dados dos clientes (LGPD art. 46)
# ---------------------------------------------------------------------------
# Nome e telefone são gravados criptografados. Gere CADA chave com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: perder a ENCRYPTION_KEY = perder nome e telefone de todos os clientes.
# Guarde uma cópia num cofre de senhas (e outra offline), FORA do backup do banco:
# backup e chave juntos no mesmo lugar anulam a proteção.
ENCRYPTION_KEY=
# Só durante uma troca de chave: as chaves antigas, separadas por vírgula, para ler o que
# ainda não foi regravado. Fora disso, deixe vazio.
ENCRYPTION_KEYS_PREVIOUS=
# Chave do índice de busca pelo telefone. DIFERENTE da ENCRYPTION_KEY.
# Trocá-la exige recalcular o índice de todos os clientes.
BLIND_INDEX_KEY=

# ---------------------------------------------------------------------------
# Clínica
# ---------------------------------------------------------------------------
# Perfil desta instalação (o tipo de negócio): define os serviços, o menu, a triagem e a
# grade de horários de exemplo. Obrigatório. Opções:
#   fisio-personal  clínica com fisioterapia e personal trainer
#   fisioterapia    só fisioterapia
#   personal        só personal trainer
CLINIC_PROFILE=fisio-personal
# Fuso usado para mostrar e calcular horários de agendamento.
CLINIC_TIMEZONE=America/Sao_Paulo
# LGPD (art. 9º): o cliente precisa saber como seus dados são tratados antes de informá-los.
# O bot envia este link no primeiro contato. Obrigatório (https) em produção.
PRIVACY_POLICY_URL=
# WhatsApp da recepção, que recebe os avisos de agendamento e cancelamento (template
# aviso_agenda_recepcao). DDI + DDD + número, ex.: 5511900000000. Precisa ser DIFERENTE do
# número do bot. Obrigatório em produção.
RECEPTION_WHATSAPP=

# ---------------------------------------------------------------------------
# Só para testes (opcional)
# ---------------------------------------------------------------------------
# Banco DESCARTÁVEL para os testes de integração (gravam dados e nunca limpam).
# Nunca aponte para o banco de verdade.
# TEST_DATABASE_URL=postgresql://chatbot:senha@localhost:55432/chatbot_teste
